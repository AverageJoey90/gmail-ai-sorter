# Reference/template for every variable docker-compose.yml understands.
#
# NONE of these are required to deploy the stack. If you leave any (or
# all) of them blank in Portainer's "Environment variables" box, the
# container still starts and the dashboard shows a one-time Setup page
# where you can type them in through the browser instead. Whatever you
# enter there is saved to the persistent /data volume and takes effect
# immediately, no redeploy needed - so filling these in here vs. on the
# Setup page is entirely a matter of preference.
#
# Deploying via Portainer: don't create a physical .env file on the NAS -
# paste whichever of these lines you want (with real values) into the
# stack's "Environment variables" section (Advanced mode / bulk paste)
# when creating or editing the stack. docker-compose.yml uses
# ${VAR:-default} syntax so it's fine to leave any of them out entirely.
#
# This is the entire list of things ever set at deploy time. Which Gmail
# accounts are connected, the daily schedule, confidence threshold, and
# ignore list are all set afterwards from the dashboard - never touched
# here or on the Setup page.

# ---- AI provider (free tier) ------------------------------------------
# Get a free key (no card required) at https://aistudio.google.com/apikey
# Optional here - can be entered on the dashboard's Setup page instead.
GEMINI_API_KEY=

# Model used for classification/summarization. gemini-2.5-flash is a good
# default; gemini-2.5-flash-lite is cheaper/faster if you hit free-tier
# rate limits with two accounts. Always defaults to gemini-2.5-flash if
# left blank, so this one's genuinely optional either way.
GEMINI_MODEL=gemini-2.5-flash

# ---- Google OAuth client (Web application type) --------------------------
# From Google Cloud Console > APIs & Services > Credentials. See the
# README's "Google Cloud OAuth setup" section for the exact steps,
# including the required Authorized redirect URI.
# Optional here - can be entered on the dashboard's Setup page instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Public HTTPS address of this NAS ------------------------------------
# No trailing slash. This must be reachable from the public internet over
# HTTPS for Google's OAuth redirect to work - see the README's "Expose the
# NAS over HTTPS" section. Recommended route (£0, no domain needed):
# Tailscale Funnel (see TAILSCALE_AUTH_KEY below) - then this is
# https://<hostname>.<your-tailnet>.ts.net. Alternatives: Cloudflare Tunnel
# (needs a domain you own, see CLOUDFLARE_TUNNEL_TOKEN below) - then this
# is https://<your-subdomain>.<your-domain>; or Asustor's own EZ-Connect +
# Certificate Manager + Reverse Proxy, e.g. https://joe123.<ddns-domain>:8443.
# Optional here - can be entered on the dashboard's Setup page instead.
PUBLIC_BASE_URL=

# ---- Tailscale Funnel (recommended £0 way to get PUBLIC_BASE_URL) --------
# Gives you a permanent public HTTPS URL with no router port-forwarding, no
# domain to buy, and no certificate to manage - Tailscale handles all of
# that. See the README's "Expose the NAS over HTTPS" section (Route C) for
# the one-time setup (generate a reusable auth key at
# login.tailscale.com/admin/settings/keys). The app runs
# `tailscaled`/`tailscale` itself as background processes the moment an
# auth key is present - no separate container. Optional here, same as
# everything else - can be entered, changed, or cleared anytime on the
# dashboard's Setup page (/setup) instead, taking effect within about 15
# seconds, no redeploy needed. Leave blank entirely if you're using Route A
# or B instead - nothing extra runs.
TAILSCALE_AUTH_KEY=

# Becomes part of your public URL, e.g. https://gmail-ai-sorter.<your-tailnet>.ts.net.
# Only used alongside TAILSCALE_AUTH_KEY above. Defaults to
# "gmail-ai-sorter" if left blank.
TAILSCALE_HOSTNAME=gmail-ai-sorter

# ---- Cloudflare Tunnel (alternative to Tailscale Funnel, needs a domain) --
# Gives you a public HTTPS URL with no router port-forwarding and no
# certificate to manage on the NAS - Cloudflare handles both, but you need
# to already own a domain name (or buy one, a few dollars/year). See the
# README's "Expose the NAS over HTTPS" section (Route A) for the one-time
# Cloudflare dashboard setup (create a tunnel, add a Public Hostname route
# pointing at http://localhost:4568, copy the token it gives you). The app
# runs `cloudflared` itself as a background process the moment a token is
# present - no separate container, since it runs inside this same one.
# Optional here, same as everything else - can be entered, changed, or
# cleared anytime on the dashboard's Setup page (/setup) instead, taking
# effect within about 15 seconds, no redeploy needed. Leave blank entirely
# if you're using Tailscale Funnel or Asustor's own EZ-Connect/Reverse
# Proxy route instead (Route C or B) - nothing extra runs.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Dashboard login ------------------------------------------------------
# The dashboard will be reachable from the internet once PUBLIC_BASE_URL
# is live, so this is what stops a stranger from using it. Pick something
# long and random, not a password you reuse anywhere else.
# Optional here - can be entered on the dashboard's Setup page instead.
DASHBOARD_PASSWORD=

# ---- Misc -----------------------------------------------------------------
TZ=Europe/London
