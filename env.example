# Reference/template for every variable docker-compose.yml expects.
#
# Deploying via Portainer: don't create a physical .env file on the NAS -
# paste these lines (with real values) into the stack's "Environment
# variables" section (Advanced mode / bulk paste) when creating or editing
# the stack in the Portainer UI. docker-compose.yml uses ${VAR} syntax so
# Portainer fills these in at deploy time regardless of a .env file.
#
# This is the ENTIRE list of things you configure at deploy time. Which
# Gmail accounts are connected, the daily schedule, confidence threshold,
# and ignore list are all set afterwards from the dashboard - never
# touched again here.

# ---- AI provider (free tier) ------------------------------------------
# Get a free key (no card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for classification/summarization. gemini-2.5-flash is a good
# default; gemini-2.5-flash-lite is cheaper/faster if you hit free-tier
# rate limits with two accounts.
GEMINI_MODEL=gemini-2.5-flash

# ---- Google OAuth client (Web application type) --------------------------
# From Google Cloud Console > APIs & Services > Credentials. See the
# README's "Google Cloud OAuth setup" section for the exact steps,
# including the required Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Public HTTPS address of this NAS ------------------------------------
# No trailing slash. This must be reachable from the public internet over
# HTTPS for Google's OAuth redirect to work - see the README's "Expose the
# NAS over HTTPS" section (Asustor EZ-Connect + Certificate Manager +
# Reverse Proxy). Example: https://joe123.myasustor.com:8443
PUBLIC_BASE_URL=

# ---- Dashboard login ------------------------------------------------------
# Required - the dashboard will be reachable from the internet once
# PUBLIC_BASE_URL is live, so this is what stops a stranger from using it.
# Pick something long and random, not a password you reuse anywhere else.
DASHBOARD_PASSWORD=

# ---- Misc -----------------------------------------------------------------
TZ=Europe/London
